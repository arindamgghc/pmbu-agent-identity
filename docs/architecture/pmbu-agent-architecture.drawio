        <mxCell id="text0" vertex="1" parent="1" value="&lt;b&gt;Cellular lab integration — proposed target placement&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=38;fontColor=#16324b;fillColor=none;strokeColor=none;">
