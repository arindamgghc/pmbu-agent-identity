        <mxCell id="text4" vertex="1" parent="1" value="PCF API/auth • lattice UE/RAN role • subscriber/PDU-session mapping • supported QoS profiles • flow filters • measurable bottleneck" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#60778b;fillColor=none;strokeColor=none;">
