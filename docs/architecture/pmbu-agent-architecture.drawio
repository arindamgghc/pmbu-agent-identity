        <mxCell id="text1" vertex="1" parent="1" value="Based on teammate setup screenshot | Addresses retained as supplied; availability and API behavior are unverified" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#60778b;fillColor=none;strokeColor=none;">
          <mxGeometry as="geometry" x="50" y="85" width="1333.3999999999999" height="38.0" />
