        <mxCell id="text2" vertex="1" parent="1" value="BLUE = supplied lab     TEAL = local prototype     AMBER / DASHED = proposed deployment or integration" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#60778b;fillColor=none;strokeColor=none;">
