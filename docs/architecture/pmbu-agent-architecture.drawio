        <mxCell id="text5" vertex="1" parent="1" value="Private host IPs identify lab machines, not workload SPIFFE IDs or confirmed subscriber addresses. No credentials appear here." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#60778b;fillColor=none;strokeColor=none;">
          <mxGeometry as="geometry" x="50" y="1375" width="1412.46" height="36.5" />
        </mxCell>
        <mxCell id="text6" vertex="1" parent="1" value="Prototype currently authorizes and schedules application work. This is a target integration design, not a claim of live cellular QoS." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#60778b;fillColor=none;strokeColor=none;">
