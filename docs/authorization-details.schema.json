{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pmbu:schema:network-qos",
  "title": "PMBU custom RAR network QoS request",
  "type": "array",
  "minItems": 1,
  "maxItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "type",
      "operation",
      "network_context",
      "flow_id",
      "flow",
      "subscriber_id",
      "pdu_session_id"
    ],
    "properties": {
      "type": {
        "const": "urn:pmbu:authorization:network-qos"
      },
      "operation": {
        "type": "string"
      },
      "network_context": {
        "enum": [
          "access",
          "edge",
          "enterprise"
        ]
      },
      "flow_id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9._:-]{1,100}$"
      },
      "subscriber_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "pdu_session_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "qos_tier": {
        "enum": [
          "background",
          "interactive",
          "critical"
        ]
      },
      "5qi": {
        "type": "integer",
        "enum": [
          7,
          8,
          9
        ]
      },
      "dscp": {
        "type": "integer",
        "enum": [
          0,
          8,
          46
        ]
      },
      "flow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "src_ip",
          "dst_ip",
          "src_port",
          "dst_port",
          "protocol"
        ],
        "properties": {
          "src_ip": {
            "type": "string"
          },
          "dst_ip": {
            "type": "string"
          },
          "src_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "dst_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "protocol": {
            "enum": [
              "tcp",
              "udp"
            ]
          }
        }
      }
    }
  }
}
